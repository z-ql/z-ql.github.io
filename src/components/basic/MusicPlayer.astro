---
// Music capsule player — port of blog.dao.js.cn's "音乐胶囊" design.
// Plays local /music/playlist.json generated by scripts/extract-music.mjs.
---

<div data-music-player>
  <audio preload='auto'></audio>

  <div class='mc-capsule' id='mc-capsule'>
    <button class='mc-cover' data-album-cover type='button' aria-label='Play/Pause' aria-pressed='false'></button>

    <div class='mc-collapsed-info'>
      <div class='mc-collapsed-title' id='mc-collapsed-title'></div>
    </div>

    <div class='mc-collapsed-icon' id='mc-collapsed-icon'></div>

    <div class='mc-song-info' id='mc-song-info'>
      <span class='mc-song-title' id='mc-song-title'></span>
      <div class='mc-lyrics'>
        <div class='mc-lyrics-content' id='mc-lyrics-content'></div>
      </div>
    </div>

    <div class='mc-controls' data-music-controls>
      <button class='mc-control-btn' id='mc-prev' type='button' aria-label='Previous track'>
        <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='white'><path d='M6 6h2v12H6zm3.5 6l8.5 6V6z'/></svg>
      </button>
      <button class='mc-control-btn mc-play-pause' id='mc-playpause' type='button' aria-label='Play/Pause'>
        <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='white'><path d='M8 5v14l11-7z'/></svg>
      </button>
      <button class='mc-control-btn' id='mc-next' type='button' aria-label='Next track'>
        <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='white'><path d='M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z'/></svg>
      </button>
      <button class='mc-control-btn' id='mc-mute' type='button' aria-label='Mute'>
        <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='white'><path d='M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z'/></svg>
      </button>
      <button class='mc-control-btn' id='mc-playlist-btn' type='button' aria-label='Playlist'>
        <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='white'><path d='M15 6H3v2h12V6zm0 4H3v2h12v-2zM3 16h8v-2H3v2zM17 6v8.18c-.31-.11-.65-.18-1-.18-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3V8h3V6h-5z'/></svg>
      </button>
    </div>

    <div class='mc-progress' id='mc-progress'></div>
  </div>

  <div class='mc-volume-popup' id='mc-volume-popup' hidden>
    <div class='mc-volume-track'>
      <div class='mc-volume-fill' id='mc-volume-fill'></div>
      <input class='mc-volume-range' id='mc-volume-range' type='range' min='0' max='100' value='70' aria-label='Volume'>
    </div>
  </div>

  <div class='mc-playlist' id='mc-playlist' hidden>
    <div class='mc-playlist-header'>
      <span id='mc-playlist-title' class='mc-playlist-title'></span>
      <span class='mc-close-playlist' id='mc-close-playlist'>×</span>
    </div>
    <div class='mc-playlist-content' id='mc-playlist-content'></div>
  </div>
</div>

<style is:global>
  [data-music-player] {
    position: fixed;
    bottom: 20px;
    left: 20px;
    z-index: 1009;
    font-family: inherit;
  }

  /* === capsule === */
  [data-music-player] .mc-capsule {
    cursor: pointer;
    background: hsl(var(--card));
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    border: 1px solid hsl(var(--border));
    border-radius: 20px;
    align-items: center;
    width: fit-content;
    max-width: 240px;
    height: 40px;
    transition: all 0.3s, color 0.3s;
    display: flex;
    position: relative;
    overflow: hidden;
  }
  [data-music-player] .mc-capsule:hover {
    transform: scale(1.02);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
  }
  [data-music-player] .mc-capsule:hover:not(.mc-expanded) {
    background: var(--dominant-color, rgba(30, 30, 30, 0.75)) !important;
  }
  [data-music-player] .mc-capsule.mc-expanded {
    width: 280px;
    max-width: 280px;
    background: var(--dominant-color, rgba(30, 30, 30, 0.75)) !important;
  }
  [data-music-player] .mc-capsule.mc-expanded:hover {
    transform: scale(1);
  }
  [data-music-player] .mc-capsule.mc-playing {
    box-shadow: 0 0 5.7px rgba(255, 255, 255, 0.45);
  }

  /* === album cover (spinning) === */
  [data-music-player] [data-album-cover] {
    z-index: 2;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    border: none;
    padding: 0;
    background-color: rgba(255, 255, 255, 0.1);
    background-position: center;
    background-size: cover;
    border-radius: 15px;
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    transition: all 0.4s;
    animation: mc-cover-spin 8s linear infinite paused;
    position: absolute;
    top: 5px;
    left: 5px;
  }
  [data-music-player] .mc-capsule.mc-playing [data-album-cover] {
    animation-play-state: running;
    box-shadow: 0 0 5.7px rgba(255, 255, 255, 0.45);
  }

  /* === collapsed info === */
  [data-music-player] .mc-collapsed-info {
    opacity: 1;
    justify-content: flex-start;
    align-items: center;
    width: 100%;
    height: 100%;
    padding: 0 15px 0 45px;
    transition: all 0.3s;
    display: flex;
  }
  [data-music-player] .mc-capsule.mc-expanded .mc-collapsed-info {
    opacity: 0;
    pointer-events: none;
  }
  [data-music-player] .mc-collapsed-title {
    min-width: 0;
    max-width: 60px;
    color: hsl(var(--card-foreground));
    text-overflow: ellipsis;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    white-space: nowrap;
    flex: 1;
    font-size: 11px;
    font-weight: 600;
    transition: all 0.3s;
    overflow: hidden;
  }
  [data-music-player] .mc-capsule:hover:not(.mc-expanded) [data-album-cover],
  [data-music-player] .mc-capsule:hover:not(.mc-expanded) .mc-collapsed-title {
    opacity: 0.3;
  }

  /* === hover play/pause overlay === */
  [data-music-player] .mc-collapsed-icon {
    pointer-events: none;
    opacity: 0;
    justify-content: center;
    align-items: center;
    width: 20px;
    height: 20px;
    transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    display: flex;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.8);
  }
  [data-music-player] .mc-capsule:hover:not(.mc-expanded) .mc-collapsed-icon {
    z-index: 10;
    pointer-events: auto;
    opacity: 1;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    transform: translate(-50%, -50%) scale(1);
  }
  [data-music-player] .mc-collapsed-icon svg {
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.3));
    width: 14px;
    height: 14px;
    display: block;
  }
  [data-music-player] .mc-capsule:hover:not(.mc-expanded) .mc-collapsed-icon svg {
    width: 20px;
    height: 20px;
  }
  [data-music-player] .mc-pause-bars {
    gap: 2px;
    display: flex;
    align-items: flex-end;
  }
  [data-music-player] .mc-pause-bar {
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.3));
    background: #fff;
    border-radius: 1px;
    width: 2px;
    height: 10px;
  }
  [data-music-player] .mc-pause-bars.mc-playing .mc-pause-bar {
    animation: mc-pause-pulse 1.5s ease-in-out infinite alternate;
  }
  [data-music-player] .mc-pause-bars.mc-playing .mc-pause-bar:nth-child(2) {
    animation-delay: 0.3s;
  }
  [data-music-player] .mc-capsule:hover:not(.mc-expanded) .mc-pause-bar {
    width: 3px;
    height: 10px;
  }
  [data-music-player] .mc-spinner-ring {
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.3));
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: #fff;
    border-radius: 50%;
    width: 14px;
    height: 14px;
    animation: mc-spinner-spin 0.8s linear infinite;
  }

  /* === expanded song info + lyrics === */
  [data-music-player] .mc-song-info {
    color: #fff;
    pointer-events: none;
    cursor: pointer;
    opacity: 0;
    flex-direction: row;
    align-items: center;
    gap: 12px;
    transition: all 0.6s cubic-bezier(0.25, 0.8, 0.25, 1);
    display: flex;
    position: absolute;
    top: 50%;
    left: 50px;
    right: 20px;
    transform: translateY(-50%) translateX(-20px);
  }
  [data-music-player] .mc-song-info.mc-visible {
    pointer-events: auto;
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }
  [data-music-player] .mc-song-title {
    color: rgba(255, 255, 255, 0.9);
    text-overflow: ellipsis;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    white-space: nowrap;
    -webkit-user-select: none;
    user-select: none;
    flex-shrink: 0;
    width: 50px;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.2;
    overflow: hidden;
  }
  [data-music-player] .mc-lyrics {
    flex: 1;
    align-items: flex-start;
    height: 40px;
    display: flex;
    position: relative;
    overflow: hidden;
  }
  [data-music-player] .mc-lyrics-content {
    will-change: transform;
    width: 100%;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: absolute;
    top: 0;
    left: 0;
  }
  [data-music-player] .mc-lyric-line {
    justify-content: flex-start;
    align-items: center;
    height: 20px;
    display: flex;
    position: relative;
    overflow: hidden;
  }
  [data-music-player] .mc-lyric-line.mc-no-lyrics {
    justify-content: center;
  }
  [data-music-player] .mc-lyric-text {
    color: rgba(255, 255, 255, 0.3);
    font-size: 10px;
    font-weight: 400;
    font-style: italic;
    text-shadow: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  [data-music-player] .mc-lyric-line.mc-current .mc-lyric-text {
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    font-style: normal;
    text-shadow: 0 1px 3px rgba(255, 255, 255, 0.3), 0 0 8px rgba(255, 255, 255, 0.15);
  }

  /* === controls === */
  [data-music-player] .mc-controls {
    z-index: 5;
    opacity: 0;
    border-radius: 0 20px 20px 0;
    justify-content: space-evenly;
    align-items: center;
    width: 150px;
    height: 100%;
    padding: 0 10px;
    transition: all 0.6s cubic-bezier(0.25, 0.8, 0.25, 1);
    display: flex;
    position: absolute;
    top: 0;
    right: -150px;
    background: linear-gradient(to left, var(--dominant-color, rgba(30, 30, 30, 0.75)) 60%, transparent);
  }
  [data-music-player] .mc-controls.mc-visible {
    opacity: 1;
    right: 0;
  }
  [data-music-player] .mc-control-btn {
    cursor: pointer;
    opacity: 0.8;
    justify-content: center;
    align-items: center;
    width: 20px;
    height: 20px;
    transition: all 0.3s;
    display: flex;
    border-radius: 50%;
    border: none;
    background: transparent;
    padding: 0;
  }
  [data-music-player] .mc-control-btn:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.15);
  }
  [data-music-player] .mc-control-btn svg {
    width: 12px;
    height: 12px;
    fill: #fff;
    display: block;
  }

  /* === progress bar === */
  [data-music-player] .mc-progress {
    z-index: 1;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.15);
    height: 100%;
    transition: width 0.3s;
    position: absolute;
    top: 0;
    left: 0;
    width: 0%;
  }

  /* === volume popup === */
  [data-music-player] .mc-volume-popup {
    position: absolute;
    bottom: calc(100% + 10px);
    right: 16px;
    width: 30px;
    height: 90px;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
    padding: 8px 0;
    z-index: 7;
  }
  [data-music-player] .mc-volume-popup[hidden] {
    display: none;
  }
  [data-music-player] .mc-volume-track {
    position: relative;
    width: 6px;
    height: 100%;
    background: rgba(0, 0, 0, 0.15);
    border-radius: 3px;
    overflow: hidden;
  }
  [data-music-player] .mc-volume-fill {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background: hsl(var(--primary));
    border-radius: 3px;
  }
  [data-music-player] .mc-volume-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
    writing-mode: vertical-lr;
    direction: rtl;
    -webkit-appearance: none;
    appearance: none;
  }

  /* === playlist panel === */
  [data-music-player] .mc-playlist {
    background: hsl(var(--primary));
    -webkit-backdrop-filter: blur(30px);
    backdrop-filter: blur(30px);
    transform-origin: 0 100%;
    border-radius: 16px;
    width: 360px;
    max-width: calc(100vw - 2rem);
    max-height: 300px;
    animation: mc-playlist-slide-in 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    position: absolute;
    top: -320px;
    left: 0;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(255, 255, 255, 0.15),
      inset 0 1px rgba(255, 255, 255, 0.1);
    z-index: 6;
  }
  [data-music-player] .mc-playlist[hidden] {
    display: none;
  }
  [data-music-player] .mc-playlist-header {
    color: #fff;
    -webkit-user-select: none;
    user-select: none;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.08));
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px 12px;
    font-size: 13px;
    font-weight: 600;
    display: flex;
  }
  [data-music-player] .mc-close-playlist {
    color: rgba(255, 255, 255, 0.8);
    cursor: pointer;
    border-radius: 50%;
    justify-content: center;
    align-items: center;
    width: 24px;
    height: 24px;
    font-size: 18px;
    line-height: 1;
    transition: all 0.3s;
    display: flex;
  }
  [data-music-player] .mc-close-playlist:hover {
    background: rgba(255, 255, 255, 0.15);
  }
  [data-music-player] .mc-playlist-content {
    scrollbar-color: rgba(255, 255, 255, 0.6) transparent;
    scrollbar-width: thin;
    max-height: 250px;
    overflow-y: auto;
  }
  [data-music-player] .mc-playlist-item {
    color: rgba(255, 255, 255, 0.9);
    cursor: pointer;
    -webkit-user-select: none;
    user-select: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    align-items: center;
    gap: 12px;
    min-height: 36px;
    padding: 8px 18px;
    transition: all 0.3s;
    display: flex;
    position: relative;
  }
  [data-music-player] .mc-playlist-item:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  [data-music-player] .mc-playlist-item.mc-active {
    color: #fff;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.1));
    font-weight: 600;
  }
  [data-music-player] .mc-item-index {
    z-index: 1;
    text-align: center;
    visibility: visible;
    opacity: 0.5;
    width: 20px;
    font-size: 12px;
    font-weight: 500;
    transition: all 0.3s;
    position: relative;
    flex-shrink: 0;
  }
  [data-music-player] .mc-play-indicator {
    z-index: 2;
    visibility: hidden;
    opacity: 0;
    justify-content: center;
    align-items: center;
    width: 20px;
    height: 14px;
    transition: all 0.3s;
    display: flex;
    position: absolute;
    top: 50%;
    left: 18px;
    transform: translateY(-50%);
  }
  [data-music-player] .mc-play-bars {
    align-items: flex-end;
    gap: 2px;
    height: 12px;
    display: flex;
  }
  [data-music-player] .mc-play-bar {
    background: rgba(255, 255, 255, 0.9);
    border-radius: 1px;
    width: 2px;
    animation: mc-bar-pulse 1.5s ease-in-out infinite;
  }
  [data-music-player] .mc-play-bar:nth-child(1) {
    height: 4px;
    animation-delay: 0s;
  }
  [data-music-player] .mc-play-bar:nth-child(2) {
    height: 8px;
    animation-delay: 0.2s;
  }
  [data-music-player] .mc-play-bar:nth-child(3) {
    height: 6px;
    animation-delay: 0.4s;
  }
  [data-music-player] .mc-play-bar:nth-child(4) {
    height: 10px;
    animation-delay: 0.6s;
  }
  [data-music-player] .mc-playlist-item.mc-active .mc-item-index {
    visibility: hidden;
    opacity: 0;
  }
  [data-music-player] .mc-playlist-item.mc-active .mc-play-indicator {
    visibility: visible;
    opacity: 1;
    animation: mc-indicator-pulse 2s ease-in-out infinite;
  }
  [data-music-player] .mc-playlist-item.mc-active .mc-item-title {
    color: #fff;
    font-weight: 600;
  }
  [data-music-player] .mc-playlist-item.mc-active .mc-item-artist {
    opacity: 0.9;
  }
  [data-music-player] .mc-item-content {
    flex-direction: column;
    flex: 1;
    gap: 1px;
    min-width: 0;
    display: flex;
  }
  [data-music-player] .mc-item-title {
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
    transition: all 0.3s;
    overflow: hidden;
  }
  [data-music-player] .mc-item-artist {
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0.7;
    font-size: 11px;
    font-weight: 400;
    line-height: 1.2;
    transition: all 0.3s;
    overflow: hidden;
  }

  /* === keyframes === */
  @keyframes mc-cover-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes mc-pause-pulse {
    from {
      height: 6px;
    }
    to {
      height: 12px;
    }
  }
  @keyframes mc-spinner-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes mc-bar-pulse {
    0%,
    100% {
      height: 4px;
      opacity: 0.7;
    }
    50% {
      height: 12px;
      opacity: 1;
    }
  }
  @keyframes mc-indicator-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.6;
    }
  }
  @keyframes mc-playlist-slide-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script is:inline>
  (function () {
    function initMusicPlayer() {
      if (window.__musicCapsuleInitialized) return
      window.__musicCapsuleInitialized = true

      const root = document.querySelector('[data-music-player]')
      if (!root) return

      const audio = root.querySelector('audio')
      const capsule = root.querySelector('.mc-capsule')
      const cover = root.querySelector('[data-album-cover]')
      const collapsedIcon = root.querySelector('.mc-collapsed-icon')
      const collapsedTitle = root.querySelector('.mc-collapsed-title')
      const songInfo = root.querySelector('.mc-song-info')
      const songTitle = root.querySelector('.mc-song-title')
      const controls = root.querySelector('.mc-controls')
      const progressEl = root.querySelector('.mc-progress')
      const playlistEl = root.querySelector('.mc-playlist')
      const playlistContent = root.querySelector('.mc-playlist-content')
      const playlistTitle = root.querySelector('.mc-playlist-title')
      const closePlaylist = root.querySelector('.mc-close-playlist')
      const lyricsContent = root.querySelector('.mc-lyrics-content')
      const volumePopup = root.querySelector('.mc-volume-popup')
      const volumeFill = root.querySelector('.mc-volume-fill')
      const volumeRange = root.querySelector('.mc-volume-range')
      const btnPlay = root.querySelector('.mc-play-pause')
      const btnPrev = root.querySelector('#mc-prev')
      const btnNext = root.querySelector('#mc-next')
      const btnMute = root.querySelector('#mc-mute')
      const btnPlaylist = root.querySelector('#mc-playlist-btn')

      let playlist = []
      let currentIndex = 0
      let expanded = false
      let hovered = false
      let playlistOpen = false
      let volumeOpen = false
      let isMuted = false
      let volume = 0.7
      let isLoading = false
      let lyrics = []
      let lyricIndex = -1

      const icons = {
        play: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"/></svg>',
        pause:
          '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white"><path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/></svg>',
        mute: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>',
        muted: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>'
      }

      /* ---- dominant color extraction (port of dao's useColorExtraction) ---- */
      const colorCache = {}
      function luminance(r, g, b) {
        const [x, y, z] = [r, g, b].map((c) => {
          const s = c / 255
          return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4)
        })
        return 0.2126 * x + 0.7152 * y + 0.0722 * z
      }
      function darken(r, g, b) {
        const l = luminance(r, g, b)
        const f = l > 0.5
          ? { r: Math.floor(0.3 * r), g: Math.floor(0.3 * g), b: Math.floor(0.3 * b) }
          : l > 0.3
            ? { r: Math.floor(0.6 * r), g: Math.floor(0.6 * g), b: Math.floor(0.6 * b) }
            : { r, g, b }
        return `rgb(${f.r}, ${f.g}, ${f.b})`
      }
      function extractDominantColor(url) {
        const fallback = 'hsl(var(--primary))'
        return new Promise((resolve) => {
          if (!url) return resolve(fallback)
          if (colorCache[url]) return resolve(colorCache[url])
          fetch(url)
            .then((res) => {
              if (!res.ok) throw new Error('image fetch failed')
              return res.blob()
            })
            .then((blob) => {
              const objectUrl = URL.createObjectURL(blob)
              const img = new Image()
              let done = false
              const finish = (color) => {
                if (done) return
                done = true
                clearTimeout(timer)
                URL.revokeObjectURL(objectUrl)
                colorCache[url] = color
                resolve(color)
              }
              const timer = setTimeout(() => finish(fallback), 5000)
              img.onload = () => {
                try {
                  if (img.width === 0 || img.height === 0) return finish(fallback)
                  const canvas = document.createElement('canvas')
                  const ctx = canvas.getContext('2d')
                  if (!ctx) return finish(fallback)
                  const scale = Math.min(300 / img.width, 300 / img.height)
                  canvas.width = Math.floor(img.width * scale)
                  canvas.height = Math.floor(img.height * scale)
                  ctx.drawImage(img, 0, 0, canvas.width, canvas.height)
                  const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data
                  const buckets = {}
                  let count = 0
                  const step = Math.max(1, Math.floor(data.length / 4000))
                  for (let i = 0; i < data.length; i += 4 * step) {
                    const r = data[i]
                    const g = data[i + 1]
                    const b = data[i + 2]
                    if (data[i + 3] < 125) continue
                    count++
                    const key = `${32 * Math.round(r / 32)},${32 * Math.round(g / 32)},${32 * Math.round(b / 32)}`
                    buckets[key] = (buckets[key] || 0) + 1
                  }
                  if (count < 10) return finish(fallback)
                  const sorted = Object.entries(buckets)
                    .sort((a, b) => b[1] - a[1])
                    .filter(([key]) => {
                      const [r, g, b] = key.split(',').map(Number)
                      return !(r > 200 && g > 200 && b > 200)
                    })
                  if (!sorted.length) return finish(fallback)
                  const [r, g, b] = sorted[0][0].split(',').map(Number)
                  finish(darken(r, g, b))
                } catch {
                  finish(fallback)
                }
              }
              img.onerror = () => finish(fallback)
              img.src = objectUrl
            })
            .catch(() => resolve(fallback))
        })
      }
      function setDominantColor(url) {
        extractDominantColor(url).then((color) => {
          root.style.setProperty('--dominant-color', color)
        })
      }

      /* ---- lyrics ---- */
      function parseLrc(text) {
        const lines = []
        const timeRe = /\[(\d{1,2}):(\d{1,2})(?:[.:](\d{1,3}))?\]/g
        for (const raw of String(text).split('\n')) {
          const line = raw.trim()
          if (!line) continue
          const times = []
          let m
          timeRe.lastIndex = 0
          while ((m = timeRe.exec(line)) !== null) {
            const min = parseInt(m[1], 10)
            const sec = parseInt(m[2], 10)
            const frac = m[3] ? parseInt(m[3].padEnd(3, '0'), 10) / 1000 : 0
            times.push(min * 60 + sec + frac)
          }
          if (!times.length) continue
          const lyricText = line.replace(timeRe, '').trim()
          if (!lyricText) continue
          for (const t of times) lines.push({ time: t, text: lyricText })
        }
        lines.sort((a, b) => a.time - b.time)
        return lines
      }
      function renderLyrics(lines) {
        lyricsContent.textContent = ''
        if (!lines.length) {
          const div = document.createElement('div')
          div.className = 'mc-lyric-line mc-no-lyrics'
          div.innerHTML = '<div class="mc-lyric-text">♪ 暂无歌词 ♪</div>'
          lyricsContent.appendChild(div)
          return
        }
        lines.forEach((l, i) => {
          const div = document.createElement('div')
          div.className = 'mc-lyric-line' + (i === 0 ? ' mc-current' : '')
          const span = document.createElement('div')
          span.className = 'mc-lyric-text'
          span.textContent = l.text
          div.appendChild(span)
          lyricsContent.appendChild(div)
        })
      }
      function updateLyrics(time) {
        if (!lyrics.length) return
        let idx = -1
        for (let i = lyrics.length - 1; i >= 0; i--) {
          if (time >= lyrics[i].time) {
            idx = i
            break
          }
        }
        if (idx === lyricIndex) return
        lyricIndex = idx
        const lines = lyricsContent.children
        for (let i = 0; i < lines.length; i++) {
          lines[i].classList.toggle('mc-current', i === idx)
        }
        lyricsContent.style.transform = `translateY(${-Math.max(0, idx * 20)}px)`
      }

      /* ---- playlist ---- */
      function renderPlaylist() {
        playlistTitle.textContent = `播放列表 (${playlist.length})`
        playlistContent.textContent = ''
        playlist.forEach((track, i) => {
          const item = document.createElement('div')
          item.className = 'mc-playlist-item' + (i === currentIndex ? ' mc-active' : '')
          item.innerHTML =
            '<span class="mc-item-index"></span>' +
            '<span class="mc-play-indicator"><span class="mc-play-bars">' +
            '<span class="mc-play-bar"></span><span class="mc-play-bar"></span>' +
            '<span class="mc-play-bar"></span><span class="mc-play-bar"></span></span></span>' +
            '<span class="mc-item-content"><span class="mc-item-title"></span><span class="mc-item-artist"></span></span>'
          item.querySelector('.mc-item-index').textContent = String(i + 1)
          item.querySelector('.mc-item-title').textContent = track.name
          item.querySelector('.mc-item-artist').textContent = track.artist
          item.addEventListener('click', () => loadTrack(i, true))
          playlistContent.appendChild(item)
        })
      }
      function refreshActive() {
        Array.from(playlistContent.children).forEach((el, i) => {
          el.classList.toggle('mc-active', i === currentIndex)
        })
      }

      /* ---- UI ---- */
      function renderIcons() {
        const playing = !audio.paused && !audio.ended
        let inner
        if (isLoading) {
          inner = '<div class="mc-spinner-ring"></div>'
        } else if (playing) {
          inner = '<span class="mc-pause-bars mc-playing"><span class="mc-pause-bar"></span><span class="mc-pause-bar"></span></span>'
        } else {
          inner = icons.play
        }
        collapsedIcon.innerHTML = inner
        btnPlay.innerHTML = playing ? icons.pause : icons.play
        btnMute.innerHTML = isMuted || volume === 0 ? icons.muted : icons.mute
        capsule.classList.toggle('mc-playing', playing)
        cover.setAttribute('aria-pressed', String(playing))
      }
      function updateUI() {
        const track = playlist[currentIndex]
        collapsedTitle.textContent = track.name
        songTitle.textContent = track.name
        cover.style.backgroundImage = track.cover ? `url("${track.cover}")` : 'none'
        refreshActive()
        setDominantColor(track.cover)
      }
      function updateProgress() {
        if (!audio.duration || !isFinite(audio.duration)) return
        progressEl.style.width = (audio.currentTime / audio.duration) * 100 + '%'
      }

      /* ---- playback ---- */
      async function loadTrack(index, autoplay) {
        currentIndex = index
        const track = playlist[currentIndex]
        isLoading = true
        renderIcons()
        audio.src = track.url
        audio.load()
        updateUI()
        lyrics = []
        lyricIndex = -1
        renderLyrics([])
        if (track.lrc) {
          try {
            const res = await fetch(track.lrc)
            if (res.ok) {
              const text = await res.text()
              lyrics = parseLrc(text)
              renderLyrics(lyrics)
              updateLyrics(0)
            }
          } catch (e) {
            /* ignore */
          }
        }
        if (autoplay) {
          audio.play().catch(() => {})
        }
      }
      function nextTrack() {
        loadTrack((currentIndex + 1) % playlist.length, true)
      }
      function prevTrack() {
        loadTrack((currentIndex - 1 + playlist.length) % playlist.length, true)
      }

      function setVolume(v) {
        volume = Math.max(0, Math.min(1, v))
        audio.volume = volume
        audio.muted = isMuted && volume > 0
        volumeFill.style.height = volume * 100 + '%'
        volumeRange.value = String(Math.round(volume * 100))
        renderIcons()
      }
      function toggleMute() {
        isMuted = !isMuted
        audio.muted = isMuted
        renderIcons()
      }

      /* ---- expand ---- */
      function syncExpand() {
        capsule.classList.toggle('mc-expanded', expanded)
        songInfo.classList.toggle('mc-visible', expanded)
        controls.classList.toggle('mc-visible', expanded && hovered)
      }
      function togglePlaylist(force) {
        playlistOpen = force !== undefined ? force : !playlistOpen
        playlistEl.hidden = !playlistOpen
        if (playlistOpen) {
          expanded = true
          syncExpand()
        }
      }
      function toggleVolume(force) {
        volumeOpen = force !== undefined ? force : !volumeOpen
        volumePopup.hidden = !volumeOpen
      }

      /* ---- events ---- */
      cover.addEventListener('click', (e) => {
        e.stopPropagation()
        if (audio.paused) audio.play().catch(() => {})
        else audio.pause()
      })
      collapsedIcon.addEventListener('click', (e) => {
        e.stopPropagation()
        if (audio.paused) audio.play().catch(() => {})
        else audio.pause()
      })
      capsule.addEventListener('mouseenter', () => {
        hovered = true
        syncExpand()
      })
      capsule.addEventListener('mouseleave', () => {
        hovered = false
        syncExpand()
      })
      capsule.addEventListener('click', (e) => {
        if (e.target.closest('[data-music-controls]')) return
        expanded = !expanded
        syncExpand()
      })
      btnPrev.addEventListener('click', prevTrack)
      btnPlay.addEventListener('click', () => {
        if (audio.paused) audio.play().catch(() => {})
        else audio.pause()
      })
      btnNext.addEventListener('click', nextTrack)
      btnMute.addEventListener('click', (e) => {
        e.stopPropagation()
        toggleMute()
      })
      btnMute.addEventListener('mouseenter', () => toggleVolume(true))
      btnMute.addEventListener('mouseleave', () => {
        setTimeout(() => {
          if (!volumePopup.matches(':hover')) toggleVolume(false)
        }, 200)
      })
      volumePopup.addEventListener('mouseenter', () => toggleVolume(true))
      volumePopup.addEventListener('mouseleave', () => toggleVolume(false))
      volumeRange.addEventListener('input', () => {
        setVolume(volumeRange.value / 100)
        if (volume > 0 && isMuted) {
          isMuted = false
          audio.muted = false
          renderIcons()
        }
      })
      btnPlaylist.addEventListener('click', (e) => {
        e.stopPropagation()
        togglePlaylist()
      })
      closePlaylist.addEventListener('click', () => togglePlaylist(false))
      document.addEventListener('click', (e) => {
        if (playlistOpen && !root.contains(e.target)) togglePlaylist(false)
        if (volumeOpen && !root.contains(e.target)) toggleVolume(false)
      })

      audio.addEventListener('play', renderIcons)
      audio.addEventListener('pause', renderIcons)
      audio.addEventListener('playing', () => {
        isLoading = false
        renderIcons()
      })
      audio.addEventListener('waiting', () => {
        isLoading = true
        renderIcons()
      })
      audio.addEventListener('canplay', () => {
        isLoading = false
        renderIcons()
      })
      audio.addEventListener('error', () => {
        isLoading = false
        renderIcons()
      })
      audio.addEventListener('timeupdate', () => {
        updateProgress()
        updateLyrics(audio.currentTime)
      })
      audio.addEventListener('ended', nextTrack)

      /* ---- init ---- */
      async function init() {
        try {
          const res = await fetch('/music/playlist.json')
          if (!res.ok) throw new Error('playlist fetch failed: ' + res.status)
          playlist = await res.json()
          if (!Array.isArray(playlist) || !playlist.length) {
            root.style.display = 'none'
            return
          }
          renderPlaylist()
          setVolume(0.7)
          const start = Math.floor(Math.random() * playlist.length)
          await loadTrack(start, false)
        } catch (e) {
          console.warn('Music capsule init failed:', e)
        }
      }
      init()
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMusicPlayer, { once: true })
    } else {
      initMusicPlayer()
    }
  })()
</script>
