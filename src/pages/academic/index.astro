---
import PageLayout from '@/layouts/CommonPage.astro'
import { PublicationSection } from '@/components/user'
import config from '@/site-config'

const headings = [
  { depth: 2, slug: 'about-me', text: 'About Me' },
  { depth: 2, slug: 'publications', text: 'Publications' }
]

const publications = [
  {
    title:
      'LDPFNet: a lightweight dual-stage polarization fusion network for underwater image descattering',
    authors: [
      { name: 'Yuhao Luo', isEqual: true },
      { name: 'Qinglin Zhong', isEqual: true, isMe: true },
      { name: 'Xing Peng', role: 'corresponding' as const },
      { name: 'Zhenliang Liu' }
    ],
    venue: 'Optics Express',
    year: '2026',
    type: 'journal' as const,
    status: 'published' as const,
    abstract:
      'Underwater polarization imaging provides physical cues to separate target-reflected light from backscattered light. LDPFNet is a lightweight dual-stage polarization fusion network that first performs global descattering via a polarization-guided encoder–decoder using intensity, DoLP, and AoP images, then refines high-frequency details at full resolution. It reaches 30.9521 dB PSNR and 0.8713 SSIM on public and natural underwater datasets with only 6.606 M parameters.',
    links: [
      { type: 'pdf', href: 'https://opg.optica.org/oe/fulltext.cfm?uri=oe-34-15-27480' },
      { type: 'doi', href: 'https://doi.org/10.1364/OE.606823' }
    ]
  }
]
---

<PageLayout title='Academic' {headings} info={{ slug: '/academic', hideComment: true }}>
  <h2 id='about-me'>About Me<a class='anchor' href='#about-me'>#</a></h2>
  <p>
    2023级本科生
  </p>

  <h2 id='publications'>Publications<a class='anchor' href='#publications'>#</a></h2>
  <div class='not-prose'>
    <PublicationSection publications={publications} />
  </div>
</PageLayout>

<script
  is:inline
  type='module'
  data-astro-rerun
  define:vars={{ npmCDN: config.npmCDN, walineServer: config.integ.waline.server }}
>
  const normalizePath = (path) => {
    if (path === '/') return path
    return path.endsWith('/') ? path.slice(0, -1) : path
  }

  const loadPageviewCount = async () => {
    const pageview = await import(`${npmCDN}/@waline/client@v3/dist/pageview.js`)
    pageview.pageviewCount({
      serverURL: walineServer,
      path: normalizePath(window.location.pathname)
    })
  }

  await loadPageviewCount()
</script>